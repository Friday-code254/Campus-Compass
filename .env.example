# Optional OpenAI-compatible chat completions endpoint.
# The app still demonstrates retrieval without these values; it will show source passages.
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=

# Retrieval cutoff is a similarity score, not a confidence probability.
# Tune it with `python -m evals.run_eval` for your own document set.
MIN_RETRIEVAL_SCORE=0.12
MIN_QUERY_COVERAGE=0.35
TOP_K=4
MAX_UPLOAD_MB=10
DATABASE_PATH=data/campus_compass.sqlite3

